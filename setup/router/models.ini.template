version = 1

# Shared defaults for every model in the catalogue.
[*]
parallel = 1
n-gpu-layers = all
split-mode = layer
device = CUDA0,CUDA1
override-tensor = token_embd.weight=CUDA0
fit = off
kv-offload = 1
op-offload = 1
flash-attn = on
jinja = 1
reasoning = on
reasoning-effort = medium
reasoning-format = deepseek
reasoning-preserve = 0
chat-template-kwargs = {"enable_thinking":true,"preserve_thinking":false}
context-shift = 0
cont-batching = 0
kv-unified = 0
cache-idle-slots = 0
cache-prompt = 1
cache-ram = 0
ctx-checkpoints = 0
load-mode = none
threads-http = 4
metrics = 1
slots = 1
temperature = 1.0
top-p = 0.95
top-k = 20
min-p = 0
presence-penalty = 0
repeat-penalty = 1
n-predict = -1

[gemma-4-31b-it-qat-q4-0-uncensored-heretic-q4-0]
model = @AI_HOME@/models/gemma-4-31B-it-qat-q4_0-uncensored-heretic-Q4_0.gguf
ctx-size = 65536
cache-type-k = q8_0
cache-type-v = q8_0
tensor-split = 2,3
batch-size = 1024
ubatch-size = 256
threads = 7
threads-batch = 8
chat-template-file = @AI_HOME@/config/gemma4-chat-template.jinja
spec-type = none
load-on-startup = false

[swift-1.5-qwen3.8-27b-q4-k-s]
